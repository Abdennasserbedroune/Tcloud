# Pour tester en local : copie ce fichier en .env et remplis-le. Ne commit JAMAIS le .env.
# Sur GitHub Actions, ces valeurs vont dans Settings → Secrets and variables → Actions.

# Token donné par @BotFather
BOT_TOKEN=

# Ton user ID Telegram (envoie /myid au bot pour l'obtenir). Plusieurs : 111,222
OWNER_IDS=

# ID de chaque canal privé (écris /id dans le canal une fois le bot admin)
CHANNEL_IMAGES=
CHANNEL_VIDEOS=
CHANNEL_JEUX=
CHANNEL_DOCS=

# Canal privé où le bot sauvegarde son index (obligatoire sur GitHub Actions)
CHANNEL_INDEX=

# 0 = tourne sans limite (PC/VPS). Le workflow GitHub met 340.
MAX_RUNTIME_MIN=0

DB_PATH=tgstore.db
